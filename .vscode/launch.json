    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter - Android Emulator + Local Plate API",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": [
                "--dart-define=PLATE_API_URL=http://10.0.2.2:8080"
            ]
        },
        {
            "name": "Flutter - Desktop + Local Plate API",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": [
                "--dart-define=PLATE_API_URL=http://localhost:8080"
            ]
        },
        {
            "name": "Flutter - Production Gateway",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": [
                "--dart-define=PLATE_API_URL=https://healthapp-plated-7ruhyvjajq-uc.a.run.app",
                "--dart-define=PLATE_API_TOKEN=${env:PLATE_API_TOKEN}"
            ]
        },
        {
            "name": "Go Server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/server",
            "env": {
                "AI_API_KEY": "${env:AI_API_KEY}",
                "AI_MODEL": "openrouter:google/gemini-2.5-flash"
            }
        }
    ],
    "compounds": [
        {
            "name": "Flutter Android Emulator + Go Server",
            "configurations": [
                "Go Server",
                "Flutter - Android Emulator + Local Plate API"
            ]
        }
    ]
}