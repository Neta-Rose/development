# Copy to .env and fill in. Never commit the real file — .gitignore covers it.
#
# Required for detection to work at all. Empty is a legal state: the service
# answers `not_configured` and the app hides AI logging.
OPENROUTER_API_KEY=

# The detector model ID (e.g., `vertex:gemini-2.5-flash`, `openrouter:google/gemini-2.5-flash`, `openai:gpt-4o`).
AI_MODEL=vertex:gemini-2.5-flash
# Legacy alias for AI_MODEL:
# OPENROUTER_MODEL=google/gemini-2.5-flash

# GCP / Vertex AI configuration (required when using vertex: models)
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# Shared secret the app must send as `Authorization: Bearer <token>`.
# LEAVING THIS EMPTY LEAVES THE ENDPOINT OPEN, and an open endpoint spends your
# OpenRouter credit for whoever finds the URL. Generate one with:
#   openssl rand -hex 32
PLATE_API_TOKEN=

ADDR=:8080

# Total budget for one detection, including the single resend after an
# unreadable reply. Keep it under the app's 30s ceiling.
OPENROUTER_TIMEOUT=24s

# Off in production: with it on, callers choose the model you are billed for.
ALLOW_MODEL_OVERRIDE=false

# OpenRouter attribution headers, both optional.
OPENROUTER_REFERER=
OPENROUTER_TITLE=healthapp plate detection
